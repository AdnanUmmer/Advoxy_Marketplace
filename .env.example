# Copy to .env and fill in. Never commit .env.
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
DEMO_MODE=False
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=
SITE_URL=http://localhost:8000

# postgis://USER:PASSWORD@HOST:PORT/NAME
DATABASE_URL=postgis://advoxy:change-me@localhost:5432/advoxy

REDIS_URL=redis://localhost:6379/0
# True runs Celery tasks inline (no worker needed in local dev)
CELERY_TASK_ALWAYS_EAGER=True

CURRENCY_CODE=USD
CURRENCY_SYMBOL=$

EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=Advoxy <no-reply@example.com>

MAPBOX_TOKEN=pk.your-mapbox-public-token
STRIPE_SECRET_KEY=sk_test_placeholder
STRIPE_PUBLISHABLE_KEY=pk_test_placeholder
STRIPE_WEBHOOK_SECRET=whsec_placeholder
