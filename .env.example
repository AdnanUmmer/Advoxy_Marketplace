# Copy to .env and fill in. Never commit .env.
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
DEMO_MODE=False
ALLOWED_HOSTS=localhost,127.0.0.1
# Production: True (hashed static file names; run collectstatic after every deploy)
STATIC_MANIFEST=False
CSRF_TRUSTED_ORIGINS=
SITE_URL=http://localhost:8000

# postgis://USER:PASSWORD@HOST:PORT/NAME
DATABASE_URL=postgis://advoxy:change-me@localhost:5432/advoxy

REDIS_URL=redis://localhost:6379/0
# True runs Celery tasks inline (no worker needed in local dev)
CELERY_TASK_ALWAYS_EAGER=True

CURRENCY_CODE=USD
CURRENCY_SYMBOL=$

EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=Advoxy <no-reply@example.com>

MAPBOX_TOKEN=pk.your-mapbox-public-token

# Sign in with Google (optional; leave empty to hide the button). Create an OAuth client
# ID of type "Web application" in Google Cloud console and add the redirect URI
# https://YOUR-DOMAIN/accounts/google/callback/ (and http://localhost:8001/accounts/google/callback/ for local use).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
STRIPE_SECRET_KEY=sk_test_placeholder
STRIPE_PUBLISHABLE_KEY=pk_test_placeholder
# Webhook signing secret: from the Stripe dashboard (Developers > Webhooks, endpoint
# https://YOUR-DOMAIN/billing/webhook/stripe/) or locally from `stripe listen`.
STRIPE_WEBHOOK_SECRET=whsec_placeholder

# One-time prices in CURRENCY_CODE (plans are database rows)
EXTRA_LISTING_PRICE=10
EXTRA_LISTING_DAYS=30
FEATURED_PRICE=25
FEATURED_DAYS=14
