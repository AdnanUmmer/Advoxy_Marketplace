# Production environment. provision.sh copies this to /srv/advoxy/app/.env and fills in
# SECRET_KEY, the database password and the domain. Fill in the rest by hand.
# This file lives on the server only. Never commit a filled-in copy.
SECRET_KEY=__SECRET_KEY__
DEBUG=False
DEMO_MODE=False
ALLOWED_HOSTS=__DOMAIN__
CSRF_TRUSTED_ORIGINS=https://__DOMAIN__
SITE_URL=https://__DOMAIN__
STATIC_MANIFEST=True
SECURE_SSL_REDIRECT=True

DATABASE_URL=postgis://advoxy:__DB_PASSWORD__@localhost:5432/advoxy
DB_CONN_MAX_AGE=60
REDIS_URL=redis://localhost:6379/0
CACHE_URL=redis://localhost:6379/1
CELERY_TASK_ALWAYS_EAGER=False

MEDIA_ROOT=/srv/advoxy/media
PRIVATE_MEDIA_ROOT=/srv/advoxy/private_media

CURRENCY_CODE=USD
CURRENCY_SYMBOL=$

EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.hostinger.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=Advoxy <no-reply@__DOMAIN__>

MAPBOX_TOKEN=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

EXTRA_LISTING_PRICE=10
EXTRA_LISTING_DAYS=30
FEATURED_PRICE=25
FEATURED_DAYS=14
