[Unit]
Description=Advoxy web app (Gunicorn)
After=network.target postgresql.service redis-server.service
Wants=postgresql.service redis-server.service

[Service]
Type=simple
User=advoxy
Group=www-data
WorkingDirectory=/srv/advoxy/app
RuntimeDirectory=advoxy
RuntimeDirectoryMode=0750
Environment=DJANGO_SETTINGS_MODULE=config.settings
ExecStart=/srv/advoxy/venv/bin/gunicorn config.wsgi:application \
    --bind unix:/run/advoxy/gunicorn.sock \
    --workers 3 --threads 2 --timeout 60 --max-requests 2000 --max-requests-jitter 200 \
    --access-logfile - --error-logfile -
ExecReload=/bin/kill -s HUP $MAINPID
Restart=on-failure
RestartSec=3
UMask=0007
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
